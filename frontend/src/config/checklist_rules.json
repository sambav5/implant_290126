{
"version": "3.1",
"rules": [

```
{
  "id": "rule_bruxism",
  "when": { "functional_risk": ["bruxism"] },
  "then": {
    "add": ["nightguard_required"],
    "warnings": [
      {
        "message": "Bruxism increases implant failure risk",
        "severity": "warning",
        "category": "functional",
        "priority": 2
      }
    ]
  }
},

{
  "id": "rule_heavy_occlusion",
  "when": { "functional_risk": ["heavy_occlusion"] },
  "then": {
    "warnings": [
      {
        "message": "Heavy occlusion — adjust loading and occlusion carefully",
        "severity": "warning",
        "category": "functional",
        "priority": 1
      }
    ]
  }
},

{
  "id": "rule_smoker",
  "when": { "medical": ["smoker"] },
  "then": {
    "warnings": [
      {
        "message": "Smoking delays healing and increases failure risk",
        "severity": "critical",
        "category": "medical",
        "priority": 3
      }
    ]
  }
},

{
  "id": "rule_uncontrolled_diabetes",
  "when": { "medical": ["uncontrolled_diabetes"] },
  "then": {
    "warnings": [
      {
        "message": "Uncontrolled diabetes — high implant failure risk",
        "severity": "critical",
        "category": "medical",
        "priority": 4
      }
    ]
  }
},

{
  "id": "rule_anticoagulants",
  "when": { "medical": ["anticoagulants"] },
  "then": {
    "warnings": [
      {
        "message": "Patient on anticoagulants — bleeding risk management required",
        "severity": "warning",
        "category": "medical",
        "priority": 2
      }
    ]
  }
},

{
  "id": "rule_bisphosphonates",
  "when": { "medical": ["bisphosphonates"] },
  "then": {
    "warnings": [
      {
        "message": "Bisphosphonate therapy — risk of osteonecrosis",
        "severity": "critical",
        "category": "medical",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_recent_mi",
  "when": { "medical": ["recent_mi"] },
  "then": {
    "warnings": [
      {
        "message": "Recent cardiac event — medical clearance required",
        "severity": "critical",
        "category": "medical",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_active_perio",
  "when": { "perio": "active" },
  "then": {
    "warnings": [
      {
        "message": "Active periodontal disease — stabilize before implant",
        "severity": "critical",
        "category": "periodontal",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_esthetic_case",
  "when": { "modifiers.esthetic": true },
  "then": {
    "add": ["papilla_prediction"],
    "warnings": [
      {
        "message": "Esthetic zone — tissue and emergence profile critical",
        "severity": "warning",
        "category": "case",
        "priority": 2
      }
    ]
  }
},

{
  "id": "rule_sinus_case",
  "when": { "modifiers.sinus": true },
  "then": {
    "warnings": [
      {
        "message": "Sinus case — assess bone height and approach",
        "severity": "critical",
        "category": "case",
        "priority": 3
      }
    ]
  }
},

{
  "id": "rule_full_arch",
  "when": { "modifiers.full_arch": true },
  "then": {
    "warnings": [
      {
        "message": "Full arch case — passive fit and cross-arch stability critical",
        "severity": "critical",
        "category": "case",
        "priority": 4
      }
    ]
  }
},

{
  "id": "rule_immediate",
  "when": { "modifiers.immediate": true },
  "then": {
    "warnings": [
      {
        "message": "Immediate placement — ensure primary stability and socket integrity",
        "severity": "critical",
        "category": "case",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_high_torque",
  "when": { "torque": { "gte": 35 } },
  "then": {
    "warnings": [
      {
        "message": "Good primary stability — immediate loading possible",
        "severity": "normal",
        "category": "stability",
        "priority": 1
      }
    ]
  }
},

{
  "id": "rule_mid_torque",
  "when": { "torque": { "gte": 25, "lt": 35 } },
  "then": {
    "warnings": [
      {
        "message": "Moderate stability — consider early loading",
        "severity": "warning",
        "category": "stability",
        "priority": 2
      }
    ]
  }
},

{
  "id": "rule_low_torque",
  "when": { "torque": { "lt": 25 } },
  "then": {
    "warnings": [
      {
        "message": "Low stability — delayed loading recommended",
        "severity": "critical",
        "category": "stability",
        "priority": 3
      }
    ]
  }
},

{
  "id": "rule_sheffield_failure",
  "when": { "sheffield_fail": true },
  "then": {
    "warnings": [
      {
        "message": "Passive fit not achieved — remake recommended",
        "severity": "critical",
        "category": "prosthetic",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_occlusion_issue",
  "when": { "occlusion_issue": true },
  "then": {
    "warnings": [
      {
        "message": "Occlusion not optimal — adjust before final delivery",
        "severity": "critical",
        "category": "prosthetic",
        "priority": 4
      }
    ]
  }
},

{
  "id": "rule_iaj_gap",
  "when": { "iaj_gap": true },
  "then": {
    "warnings": [
      {
        "message": "IAJ gap detected — reseating required",
        "severity": "critical",
        "category": "prosthetic",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_mobility",
  "when": { "mobility": true },
  "then": {
    "warnings": [
      {
        "message": "Implant mobility — high risk of failure",
        "severity": "critical",
        "category": "prosthetic",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_full_arch_impression",
  "when": { "modifiers.full_arch": true },
  "then": {
    "warnings": [
      {
        "message": "Full arch impression — jig verification required",
        "severity": "critical",
        "category": "prosthetic",
        "priority": 4
      }
    ]
  }
},

{
  "id": "rule_multi_unit_impression",
  "when": { "multi_unit": true },
  "then": {
    "warnings": [
      {
        "message": "Multiple implants — open tray impression recommended",
        "severity": "warning",
        "category": "prosthetic",
        "priority": 2
      }
    ]
  }
},

{
  "id": "rule_buccal_plate_thin",
  "when": {
    "clinicalInputs.buccal_plate_thickness": { "lt": 1 }
  },
  "then": {
    "warnings": [
      {
        "message": "Thin buccal plate — graft recommended",
        "severity": "critical",
        "category": "local",
        "priority": 4
      }
    ]
  }
},

{
  "id": "rule_socket_defect",
  "when": { "socket_wall_loss": true },
  "then": {
    "warnings": [
      {
        "message": "Socket defect — immediate placement risk",
        "severity": "critical",
        "category": "case",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_soft_tissue_unstable",
  "when": { "soft_tissue_stable": false },
  "then": {
    "warnings": [
      {
        "message": "Soft tissue not stable — delay impression",
        "severity": "critical",
        "category": "impression",
        "priority": 4
      }
    ]
  }
},

{
  "id": "rule_torque_incomplete",
  "when": { "torque_stage_3_done": false },
  "then": {
    "warnings": [
      {
        "message": "Final torque incomplete",
        "severity": "critical",
        "category": "prosthetic",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_peri_implantitis",
  "when": { "bop": true, "bone_loss": true },
  "then": {
    "warnings": [
      {
        "message": "Peri-implantitis suspected",
        "severity": "critical",
        "category": "maintenance",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_implant_mobility_critical",
  "when": { "mobility": true },
  "then": {
    "warnings": [
      {
        "message": "Implant mobility detected — high failure risk",
        "severity": "critical",
        "category": "prosthetic",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_osteotomy_overprep",
  "when": { "osteotomy_overprep": true },
  "then": {
    "warnings": [
      {
        "message": "Osteotomy wider than implant — risk of poor stability",
        "severity": "warning",
        "category": "surgical",
        "priority": 3
      }
    ]
  }
},

{
  "id": "rule_isq_low",
  "when": { "isq": { "lt": 60 } },
  "then": {
    "warnings": [
      {
        "message": "Low ISQ — consider delayed loading",
        "severity": "critical",
        "category": "stability",
        "priority": 5
      }
    ]
  }
},

{
  "id": "rule_patient_education",
  "when": { "phase": "delivery" },
  "then": {
    "warnings": [
      {
        "message": "Educate patient on hygiene and recall",
        "severity": "normal",
        "category": "experience",
        "priority": 1
      }
    ]
  }
}
]
}
