{
  "version": "3.0",
  "rules": [
    {
      "id": "rule_bruxism",
      "when": {
        "functional_risk": [
          "bruxism"
        ]
      },
      "then": {
        "add": [
          "nightguard_required"
        ],
        "warnings": [
          {
            "message": "Bruxism increases implant failure risk",
            "severity": "medium",
            "category": "functional",
            "priority": 2
          }
        ]
      }
    },
    {
      "id": "rule_heavy_occlusion",
      "when": {
        "functional_risk": [
          "heavy_occlusion"
        ]
      },
      "then": {
        "warnings": [
          {
            "message": "Heavy occlusion \u2014 adjust loading and occlusion carefully",
            "severity": "medium",
            "category": "functional",
            "priority": 1
          }
        ]
      }
    },
    {
      "id": "rule_smoker",
      "when": {
        "medical": [
          "smoker"
        ]
      },
      "then": {
        "warnings": [
          {
            "message": "Smoking delays healing and increases failure risk",
            "severity": "high",
            "category": "medical",
            "priority": 3
          }
        ]
      }
    },
    {
      "id": "rule_uncontrolled_diabetes",
      "when": {
        "medical": [
          "uncontrolled_diabetes"
        ]
      },
      "then": {
        "warnings": [
          {
            "message": "Uncontrolled diabetes \u2014 high implant failure risk",
            "severity": "high",
            "category": "medical",
            "priority": 4
          }
        ]
      }
    },
    {
      "id": "rule_anticoagulants",
      "when": {
        "medical": [
          "anticoagulants"
        ]
      },
      "then": {
        "warnings": [
          {
            "message": "Patient on anticoagulants \u2014 bleeding risk management required",
            "severity": "medium",
            "category": "medical",
            "priority": 2
          }
        ]
      }
    },
    {
      "id": "rule_bisphosphonates",
      "when": {
        "medical": [
          "bisphosphonates"
        ]
      },
      "then": {
        "warnings": [
          {
            "message": "Bisphosphonate therapy \u2014 risk of osteonecrosis",
            "severity": "high",
            "category": "medical",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_recent_mi",
      "when": {
        "medical": [
          "recent_mi"
        ]
      },
      "then": {
        "warnings": [
          {
            "message": "Recent cardiac event \u2014 medical clearance required",
            "severity": "high",
            "category": "medical",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_active_perio",
      "when": {
        "perio": "active"
      },
      "then": {
        "warnings": [
          {
            "message": "Active periodontal disease \u2014 stabilize before implant",
            "severity": "high",
            "category": "periodontal",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_esthetic_case",
      "when": {
        "modifiers.esthetic": true
      },
      "then": {
        "add": [
          "papilla_prediction"
        ],
        "warnings": [
          {
            "message": "Esthetic zone \u2014 tissue and emergence profile critical",
            "severity": "medium",
            "category": "case",
            "priority": 2
          }
        ]
      }
    },
    {
      "id": "rule_sinus_case",
      "when": {
        "modifiers.sinus": true
      },
      "then": {
        "warnings": [
          {
            "message": "Sinus case \u2014 assess bone height and approach",
            "severity": "high",
            "category": "case",
            "priority": 3
          }
        ]
      }
    },
    {
      "id": "rule_full_arch",
      "when": {
        "modifiers.full_arch": true
      },
      "then": {
        "warnings": [
          {
            "message": "Full arch case \u2014 passive fit and cross-arch stability critical",
            "severity": "high",
            "category": "case",
            "priority": 4
          }
        ]
      }
    },
    {
      "id": "rule_immediate",
      "when": {
        "modifiers.immediate": true
      },
      "then": {
        "warnings": [
          {
            "message": "Immediate placement \u2014 ensure primary stability and socket integrity",
            "severity": "high",
            "category": "case",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_high_torque",
      "when": {
        "torque": {
          "gte": 35
        }
      },
      "then": {
        "warnings": [
          {
            "message": "Good primary stability \u2014 immediate loading possible",
            "severity": "low",
            "category": "stability",
            "priority": 1
          }
        ]
      }
    },
    {
      "id": "rule_mid_torque",
      "when": {
        "torque": {
          "gte": 25,
          "lt": 35
        }
      },
      "then": {
        "warnings": [
          {
            "message": "Moderate stability \u2014 consider early loading",
            "severity": "medium",
            "category": "stability",
            "priority": 2
          }
        ]
      }
    },
    {
      "id": "rule_low_torque",
      "when": {
        "torque": {
          "lt": 25
        }
      },
      "then": {
        "warnings": [
          {
            "message": "Low stability \u2014 delayed loading recommended",
            "severity": "high",
            "category": "stability",
            "priority": 3
          }
        ]
      }
    },
    {
      "id": "rule_sheffield_failure",
      "when": {
        "sheffield_fail": true
      },
      "then": {
        "warnings": [
          {
            "message": "Passive fit not achieved \u2014 remake recommended",
            "severity": "high",
            "category": "prosthetic",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_occlusion_issue",
      "when": {
        "occlusion_issue": true
      },
      "then": {
        "warnings": [
          {
            "message": "Occlusion not optimal \u2014 adjust before final delivery",
            "severity": "high",
            "category": "prosthetic",
            "priority": 4
          }
        ]
      }
    },
    {
      "id": "rule_iaj_gap",
      "when": {
        "iaj_gap": true
      },
      "then": {
        "warnings": [
          {
            "message": "IAJ gap detected \u2014 reseating required",
            "severity": "high",
            "category": "prosthetic",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_mobility",
      "when": {
        "mobility": true
      },
      "then": {
        "warnings": [
          {
            "message": "Implant mobility \u2014 high risk of failure",
            "severity": "high",
            "category": "prosthetic",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_full_arch_impression",
      "when": {
        "modifiers.full_arch": true
      },
      "then": {
        "warnings": [
          {
            "message": "Full arch impression \u2014 jig verification required",
            "severity": "high",
            "category": "prosthetic",
            "priority": 4
          }
        ]
      }
    },
    {
      "id": "rule_multi_unit_impression",
      "when": {
        "multi_unit": true
      },
      "then": {
        "warnings": [
          {
            "message": "Multiple implants \u2014 open tray impression recommended",
            "severity": "medium",
            "category": "prosthetic",
            "priority": 2
          }
        ]
      }
    },
    {
      "id": "rule_buccal_plate_thin",
      "when": {
        "clinicalInputs.buccal_plate_thickness": {
          "lt": 1
        }
      },
      "then": {
        "warnings": [
          {
            "message": "Thin buccal plate \u2014 graft recommended",
            "severity": "high",
            "category": "local",
            "priority": 4
          }
        ]
      }
    },
    {
      "id": "rule_socket_defect",
      "when": {
        "socket_wall_loss": true
      },
      "then": {
        "warnings": [
          {
            "message": "Socket defect \u2014 immediate placement risk",
            "severity": "high",
            "category": "case",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_soft_tissue_unstable",
      "when": {
        "soft_tissue_stable": false
      },
      "then": {
        "warnings": [
          {
            "message": "Soft tissue not stable \u2014 delay impression",
            "severity": "high",
            "category": "impression",
            "priority": 4
          }
        ]
      }
    },
    {
      "id": "rule_torque_incomplete",
      "when": {
        "torque_stage_3_done": false
      },
      "then": {
        "warnings": [
          {
            "message": "Final torque incomplete",
            "severity": "high",
            "category": "prosthetic",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_peri_implantitis",
      "when": {
        "bop": true,
        "bone_loss": true
      },
      "then": {
        "warnings": [
          {
            "message": "Peri-implantitis suspected",
            "severity": "high",
            "category": "maintenance",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_implant_mobility_critical",
      "when": {
        "mobility": true
      },
      "then": {
        "warnings": [
          {
            "message": "Implant mobility detected \u2014 high failure risk",
            "severity": "critical",
            "category": "prosthetic",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_osteotomy_overprep",
      "when": {
        "osteotomy_overprep": true
      },
      "then": {
        "warnings": [
          {
            "message": "Osteotomy wider than implant \u2014 risk of poor stability",
            "severity": "warning",
            "category": "surgical",
            "priority": 3
          }
        ]
      }
    },
    {
      "id": "rule_isq_low",
      "when": {
        "isq": {
          "lt": 60
        }
      },
      "then": {
        "warnings": [
          {
            "message": "Low ISQ \u2014 consider delayed loading",
            "severity": "critical",
            "category": "stability",
            "priority": 5
          }
        ]
      }
    },
    {
      "id": "rule_patient_education",
      "when": {
        "phase": "delivery"
      },
      "then": {
        "warnings": [
          {
            "message": "Educate patient on hygiene and recall",
            "severity": "normal",
            "category": "experience",
            "priority": 1
          }
        ]
      }
    }
  ]
}