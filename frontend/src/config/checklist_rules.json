{
  "version": "3.0",
  "rules": [

    /* =========================
       FUNCTIONAL RISK
    ========================= */

    {
      "id": "rule_bruxism",
      "when": { "functional_risk": ["bruxism"] },
      "then": {
        "add": ["nightguard_required"],
        "warnings": [
          {
            "message": "Bruxism increases implant failure risk",
            "severity": "medium",
            "category": "functional",
            "priority": 2
          }
        ]
      }
    },

    {
      "id": "rule_heavy_occlusion",
      "when": { "functional_risk": ["heavy_occlusion"] },
      "then": {
        "warnings": [
          {
            "message": "Heavy occlusion — adjust loading and occlusion carefully",
            "severity": "medium",
            "category": "functional",
            "priority": 1
          }
        ]
      }
    },

    /* =========================
       MEDICAL RISK
    ========================= */

    {
      "id": "rule_smoker",
      "when": { "medical": ["smoker"] },
      "then": {
        "warnings": [
          {
            "message": "Smoking delays healing and increases failure risk",
            "severity": "high",
            "category": "medical",
            "priority": 3
          }
        ]
      }
    },

    {
      "id": "rule_uncontrolled_diabetes",
      "when": { "medical": ["uncontrolled_diabetes"] },
      "then": {
        "warnings": [
          {
            "message": "Uncontrolled diabetes — high implant failure risk",
            "severity": "high",
            "category": "medical",
            "priority": 4
          }
        ]
      }
    },

    {
      "id": "rule_anticoagulants",
      "when": { "medical": ["anticoagulants"] },
      "then": {
        "warnings": [
          {
            "message": "Patient on anticoagulants — bleeding risk management required",
            "severity": "medium",
            "category": "medical",
            "priority": 2
          }
        ]
      }
    },

    {
      "id": "rule_bisphosphonates",
      "when": { "medical": ["bisphosphonates"] },
      "then": {
        "warnings": [
          {
            "message": "Bisphosphonate therapy — risk of osteonecrosis",
            "severity": "high",
            "category": "medical",
            "priority": 5
          }
        ]
      }
    },

    {
      "id": "rule_recent_mi",
      "when": { "medical": ["recent_mi"] },
      "then": {
        "warnings": [
          {
            "message": "Recent cardiac event — medical clearance required",
            "severity": "high",
            "category": "medical",
            "priority": 5
          }
        ]
      }
    },

    /* =========================
       PERIODONTAL
    ========================= */

    {
      "id": "rule_active_perio",
      "when": { "perio": "active" },
      "then": {
        "warnings": [
          {
            "message": "Active periodontal disease — stabilize before implant",
            "severity": "high",
            "category": "periodontal",
            "priority": 5
          }
        ]
      }
    },

    /* =========================
       CASE TYPE
    ========================= */

    {
      "id": "rule_esthetic_case",
      "when": { "caseType": ["esthetic"] },
      "then": {
        "add": ["papilla_prediction"],
        "warnings": [
          {
            "message": "Esthetic zone — tissue and emergence profile critical",
            "severity": "medium",
            "category": "case",
            "priority": 2
          }
        ]
      }
    },

    {
      "id": "rule_sinus_case",
      "when": { "caseType": ["sinus"] },
      "then": {
        "warnings": [
          {
            "message": "Sinus case — assess bone height and approach",
            "severity": "high",
            "category": "case",
            "priority": 3
          }
        ]
      }
    },

    {
      "id": "rule_full_arch",
      "when": { "caseType": ["full_arch"] },
      "then": {
        "warnings": [
          {
            "message": "Full arch case — passive fit and cross-arch stability critical",
            "severity": "high",
            "category": "case",
            "priority": 4
          }
        ]
      }
    },

    {
      "id": "rule_immediate",
      "when": { "caseType": ["immediate"] },
      "then": {
        "warnings": [
          {
            "message": "Immediate placement — ensure primary stability and socket integrity",
            "severity": "high",
            "category": "case",
            "priority": 5
          }
        ]
      }
    },

    /* =========================
       STABILITY (TORQUE)
    ========================= */

    {
      "id": "rule_high_torque",
      "when": { "torque": { "gte": 35 } },
      "then": {
        "warnings": [
          {
            "message": "Good primary stability — immediate loading possible",
            "severity": "low",
            "category": "stability",
            "priority": 1
          }
        ]
      }
    },

    {
      "id": "rule_mid_torque",
      "when": { "torque": { "gte": 25, "lt": 35 } },
      "then": {
        "warnings": [
          {
            "message": "Moderate stability — consider early loading",
            "severity": "medium",
            "category": "stability",
            "priority": 2
          }
        ]
      }
    },

    {
      "id": "rule_low_torque",
      "when": { "torque": { "lt": 25 } },
      "then": {
        "warnings": [
          {
            "message": "Low stability — delayed loading recommended",
            "severity": "high",
            "category": "stability",
            "priority": 3
          }
        ]
      }
    },

    /* =========================
       PROSTHETIC / DELIVERY
    ========================= */

    {
      "id": "rule_sheffield_failure",
      "when": { "sheffield_fail": true },
      "then": {
        "warnings": [
          {
            "message": "Passive fit not achieved — remake recommended",
            "severity": "high",
            "category": "prosthetic",
            "priority": 5
          }
        ]
      }
    },

    {
      "id": "rule_occlusion_issue",
      "when": { "occlusion_issue": true },
      "then": {
        "warnings": [
          {
            "message": "Occlusion not optimal — adjust before final delivery",
            "severity": "high",
            "category": "prosthetic",
            "priority": 4
          }
        ]
      }
    },

    {
      "id": "rule_iaj_gap",
      "when": { "iaj_gap": true },
      "then": {
        "warnings": [
          {
            "message": "IAJ gap detected — reseating required",
            "severity": "high",
            "category": "prosthetic",
            "priority": 5
          }
        ]
      }
    },

    {
      "id": "rule_mobility",
      "when": { "mobility": true },
      "then": {
        "warnings": [
          {
            "message": "Implant mobility — high risk of failure",
            "severity": "high",
            "category": "prosthetic",
            "priority": 5
          }
        ]
      }
    },
    {
  "id": "rule_full_arch_impression",
  "when": { "caseType": ["full_arch"] },
  "then": {
    "warnings": [
      {
        "message": "Full arch impression — jig verification required",
        "severity": "high",
        "category": "prosthetic",
        "priority": 4
      }
    ]
  }
},
{
  "id": "rule_multi_unit_impression",
  "when": { "multi_unit": true },
  "then": {
    "warnings": [
      {
        "message": "Multiple implants — open tray impression recommended",
        "severity": "medium",
        "category": "prosthetic",
        "priority": 2
      }
    ]
  }
}

  ]
}
